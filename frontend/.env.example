# ============================================================
# .env.example — Environment variables for local development
# ============================================================

# The base URL of your FastAPI backend.
# For local development, use:
VITE_API_URL=http://localhost:8000

# For production (Vercel), set this to your Render deployment URL:
# VITE_API_URL=https://your-backend-name.onrender.com

# Development mode: set to "true" to use mock data instead of API calls.
# Remove or set to "false" for production.
VITE_USE_MOCK=true
